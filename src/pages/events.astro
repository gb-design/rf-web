---
import BaseLayout from "../layouts/BaseLayout.astro";
import ButtonLink from "../components/ButtonLink.astro";
import Container from "../components/Container.astro";
import Grid from "../components/Grid.astro";
import EventCard from "../components/EventCard.astro";
import EventFilter from "../components/EventFilter.astro";
import EventList from "../components/EventList.astro";
import MetaIcon from "../components/MetaIcon.astro";
import { datumBereich, isoDatum, zeitBereich } from "../lib/eventDatum";
import {
  kommendeEvents,
  vergangeneEvents,
  nachJahr,
  verfuegbareTypen,
  TYP_LABEL,
} from "../lib/events";

const kommend = kommendeEvents();
const archivJahre = nachJahr(vergangeneEvents());

// Liest aus denselben Daten wie die Liste. Ein fest eingetragener Termin würde
// gegen den Inhalt altern, sobald der Kunde Termine pflegt.
const naechster = kommend[0];

const naechsterZeit = naechster
  ? zeitBereich(
      naechster.startTime,
      naechster.endTime,
      isoDatum(naechster.startDate) !== isoDatum(naechster.endDate),
    )
  : null;
const naechsterOrt = naechster
  ? naechster.isOnline
    ? "Online"
    : [naechster.locationName, naechster.city].filter(Boolean).join(", ")
  : "";
const naechsterTyp = naechster
  ? [TYP_LABEL[naechster.eventType], naechster.isOnline ? "Online" : null]
      .filter(Boolean)
      .join(" · ")
  : "";

const typen = verfuegbareTypen(kommend);
// Ein einzelner Filter kann nichts eingrenzen und wäre nur Dekoration.
const zeigeFilter = typen.length > 1;

const jsonLd = kommend.map((e) => ({
  "@context": "https://schema.org",
  "@type": "Event",
  name: e.title,
  startDate: e.startDate,
  endDate: e.endDate,
  description: e.excerpt,
  eventStatus:
    e.status === "cancelled"
      ? "https://schema.org/EventCancelled"
      : "https://schema.org/EventScheduled",
  eventAttendanceMode: e.isOnline
    ? "https://schema.org/OnlineEventAttendanceMode"
    : "https://schema.org/OfflineEventAttendanceMode",
  location: e.isOnline
    ? { "@type": "VirtualLocation", url: e.externalUrl }
    : {
        "@type": "Place",
        name: e.locationName,
        address: { "@type": "PostalAddress", addressLocality: e.city },
      },
  ...(e.externalUrl ? { url: e.externalUrl } : {}),
}));
---

<BaseLayout
  title="Events & Kongresse | Hernienchirurgie"
  description="Aktuelle Kongresse, Kurse und Fortbildungen zu Hernienchirurgie, Bauchwandrekonstruktion und minimalinvasiver Chirurgie."
>
  <section class="hero">
    <Container>
      <Grid class="hero__grid">
        <div class="hero__head">
          <p class="hero__eyebrow grid-label">Fachveranstaltungen</p>
          <h1 class="hero__titel">Events und Kongresse</h1>
          <p class="hero__lead">
            Ausgewählte Kongresse, Kurse, Workshops und Webinare zu Hernienchirurgie,
            Bauchwandrekonstruktion und minimalinvasiven Verfahren.
          </p>
        </div>

        <div class="hero__media">
          <img
            src="/images/events/hero-kongress.jpg"
            width="1400"
            height="1750"
            alt=""
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </Grid>

    </Container>
  </section>

  {naechster && (
    <section class="naechster" aria-labelledby="naechster-label">
      <Container>
        <Grid>
          <article class="naechster__karte">
            <p class="naechster__label grid-label" id="naechster-label">
              <span class="naechster__marke" aria-hidden="true"></span>
              Nächster Termin
            </p>

            {/* Erst wann, dann was — dieselbe Grammatik wie die Zeilen unten. */}
            <div class="naechster__wann">
              <p class="naechster__datum">
                <time datetime={isoDatum(naechster.startDate)}>
                  {datumBereich(naechster.startDate, naechster.endDate)}
                </time>
              </p>
              {naechsterZeit && (
                <p class="naechster__uhr">
                  <MetaIcon name="clock" />
                  <span>{naechsterZeit}</span>
                </p>
              )}
            </div>

            <div class="naechster__was">
              <p class="naechster__typ">{naechsterTyp}</p>
              <h2 class="naechster__titel">{naechster.title}</h2>
              <p class="naechster__ort">
                <MetaIcon name="pin" />
                <span>{naechsterOrt}</span>
              </p>
              {naechster.externalUrl && (
                <ButtonLink
                  href={naechster.externalUrl}
                  variant="text"
                  arrow
                  target="_blank"
                  class="naechster__cta"
                >
                  {naechster.linkLabel ?? "Zur Veranstaltung"}
                </ButtonLink>
              )}
            </div>

            {naechster.image && (
              <img
                class="naechster__bild"
                src={naechster.image.src}
                width={naechster.image.width}
                height={naechster.image.height}
                alt={naechster.imageAlt ?? ""}
                loading="lazy"
                decoding="async"
              />
            )}
          </article>
        </Grid>
      </Container>
    </section>
  )}

  <section class="section">
    <Container>
      {/* `.events` muss Filter und Zeilen gemeinsam umschließen — die
          :has()-Regeln in EventList lesen von hier aus nach unten. */}
      <Grid class:list={["events-sektion", { events: kommend.length > 0 }]}>
        <div class="events-sektion__aside">
          <h2 class="events-sektion__titel grid-label">Kommende Veranstaltungen</h2>
          {zeigeFilter && <EventFilter typen={typen} gesamt={kommend.length} />}
        </div>

        <div class="events-sektion__inhalt">
          {kommend.length === 0 ? (
            <p class="events-sektion__leer">
              Derzeit sind keine neuen Veranstaltungen veröffentlicht. Schauen Sie zu einem
              späteren Zeitpunkt wieder vorbei.
            </p>
          ) : (
            <EventList events={kommend} />
          )}
        </div>
      </Grid>
    </Container>
  </section>

  {archivJahre.length > 0 && (
    <section class="section">
      <Container>
        <Grid class="events-sektion">
          {/* Gleiche Struktur wie oben, damit der Titel seine drei Spalten
              behält. Ohne den Wrapper fiele er in eine einzelne Zwölftelspalte. */}
          <div class="events-sektion__aside events-sektion__aside--statisch">
            <h2 class="events-sektion__titel grid-label">Vergangene Veranstaltungen</h2>
          </div>
          <div class="events-sektion__inhalt">
            <p class="events-sektion__text">
              Frühere Termine können nach Jahr aufgerufen werden. Das Archiv dient der
              Dokumentation; Anmeldelinks abgelaufener Veranstaltungen werden nicht
              hervorgehoben.
            </p>
            {archivJahre.map(({ jahr, events }) => (
              <div class="archiv-jahr">
                <h3 class="archiv-jahr__titel">{jahr}</h3>
                <ol class="archiv-jahr__liste">
                  {events.map((event) => (
                    <EventCard event={event} compact headingLevel={4} />
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </Grid>
      </Container>
    </section>
  )}

  <section class="section section--hinweis">
    <Container>
      <Grid>
        <p class="events-hinweis">
          Für Programm, Anmeldung, Teilnahmebedingungen und mögliche Änderungen ist der
          jeweilige Veranstalter verantwortlich. Externe Links führen auf die Website des
          Veranstalters.
        </p>
      </Grid>
    </Container>
  </section>

  {/* Bewusst inline: JSON-LD ist Datenblock, kein ausfuehrbares Skript. Ob das
      unter script-src 'self' durchgeht, wird im CSP-Durchgang verifiziert. */}
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────── */

  .hero {
    /* Abstand vom Containerrand bis zur Viewportkante. Genau darum darf das
       Bild nach rechts überlaufen. */
    --bleed: max(var(--site-margin), (100vw - var(--site-max-width)) / 2);

    padding-block: clamp(var(--space-12), 7vw, var(--space-24)) 0;
    background: var(--color-bg);
  }

  :global(.hero__grid) {
    align-items: center;
    --grid-row-gap: var(--space-12);
  }

  .hero__head {
    grid-column: 1 / span 6;
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-6);
    color: var(--color-primary-strong);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero__titel {
    margin: 0 0 var(--space-8);
    max-width: 12ch;
    font-size: var(--text-h1);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.04em;
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .hero__lead {
    margin: 0;
    max-width: 46ch;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
  }

  .hero__media {
    grid-column: 7 / -1;
  }

  .hero__media img {
    /* Läuft randlos aus dem Viewport. Sicher, weil global.css `overflow: clip`
       auf dem Body setzt — die Scrollbalkenbreite in 100vw erzeugt dadurch
       keinen horizontalen Overflow. */
    width: calc(100% + var(--bleed));
    max-width: none;
    height: auto;
    aspect-ratio: 4 / 5;
    max-height: 34rem;
    object-fit: cover;
    border-radius: var(--radius-image) 0 0 var(--radius-image);
  }

  /* ── Nächster Termin ───────────────────────────────── */

  .naechster {
    padding-block: var(--content-space);
  }

  .naechster__karte {
    grid-column: 1 / -1;
    display: grid;
    /* Wann · Was · Bild — dieselbe Gliederung wie die Listenzeilen darunter.
       Das Bild verankert die rechte Kante; ohne Bild fällt die Spalte weg,
       statt eine leere Fläche stehen zu lassen. */
    grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr);
    column-gap: var(--space-12);
    row-gap: var(--space-8);
    align-items: start;
    padding: clamp(var(--space-8), 4vw, var(--space-12));
    background: var(--color-surface);
    /* Einzige Akzentfläche der Seite. Sie trägt allein die Hierarchie —
       deshalb links kein Radius, damit die Kante scharf bleibt. */
    border-inline-start: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-image) var(--radius-image) 0;
  }

  .naechster__label {
    grid-column: 1 / -1;
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Dasselbe Sechseck wie im Statuslabel der Startseite. */
  .naechster__marke {
    width: 0.6rem;
    aspect-ratio: 0.8660254;
    flex-shrink: 0;
    background: var(--color-accent);
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
  }

  .naechster__wann {
    display: grid;
    gap: var(--space-2);
  }

  .naechster__datum,
  .naechster__uhr {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }

  .naechster__datum {
    color: var(--color-text);
    font-size: var(--text-h3);
  }

  .naechster__uhr {
    color: var(--color-text-muted);
    font-size: var(--text-meta);
  }

  .naechster__was {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .naechster__typ {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-meta);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .naechster__titel {
    margin: 0;
    font-size: var(--text-h2);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .naechster__ort {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-meta);
  }

  .naechster__karte:not(:has(.naechster__bild)) {
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
  }

  .naechster__bild {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-image);
  }

  :global(.naechster__cta) {
    margin-top: var(--space-3);
  }

  /* ── Sektionen ─────────────────────────────────────── */

  .section {
    padding-block: clamp(var(--space-16), 8vw, var(--space-24));
  }

  .section--hinweis {
    padding-top: 0;
  }

  :global(.events-sektion) {
    --grid-row-gap: var(--space-8);
  }

  .events-sektion__aside {
    /* Vier statt drei Spalten, damit die Filterpillen nicht zu zweit
       umbrechen. */
    grid-column: 1 / span 3;
    display: grid;
    /* Ohne feste Spur legt sich die einzige auto-Spalte auf die Max-Content-
       Breite der Überschrift, und die Filterleiste bleibt schmaler als ihre
       Rasterspalte. Die Pillen brachen dadurch am Titel um, nicht am Raster. */
    grid-template-columns: minmax(0, 1fr);
    /* Der gewünschte Abstand zwischen Titel und Filterleiste. */
    gap: var(--space-8);
    align-content: start;

    position: sticky;
    /* Der Header ist selbst sticky und muss freigehalten werden. */
    top: calc(var(--header-height) + var(--space-8));
    /* Ohne `start` streckt das Grid-Item sich über die volle Zeilenhöhe und
       hat dann keinen Weg, an dem es kleben könnte. */
    align-self: start;
  }

  /* Das Archiv braucht keine mitlaufende Spalte — es ist kurz und trägt
     keinen Filter. */
  .events-sektion__aside--statisch {
    position: static;
  }

  /* Bewusst ohne eigenes `grid-column`: Der Titel liegt immer in
     `.events-sektion__aside`, und diese Spalte ist selbst ein Grid. Eine
     Spaltenregel hier würde dort vier Spuren erzwingen und die Filterleiste
     in die erste davon drücken. Die Rasterbreite setzt allein der Wrapper. */
  .events-sektion__titel {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .events-sektion__inhalt {
    grid-column: 5 / -1;
  }

  .events-sektion__leer {
    margin: 0;
    max-width: 55ch;
    color: var(--color-text-muted);
  }

  .events-sektion__text {
    margin: 0 0 var(--space-12);
    max-width: 55ch;
    color: var(--color-text-muted);
  }

  .archiv-jahr {
    margin-top: var(--space-12);
  }

  .archiv-jahr:first-of-type {
    margin-top: 0;
  }

  .archiv-jahr__titel {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .archiv-jahr__liste {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .events-hinweis {
    grid-column: 5 / -1;
    margin: 0;
    max-width: 62ch;
    color: var(--color-text-muted);
    font-size: var(--text-meta);
  }

  /* Drei Spalten fassen „Veranstaltungen" nicht mehr. Derselbe Wert wie in
     PageIntro, index.astro und profil.astro. */
  @media (max-width: 64rem) {
    .events-sektion__aside,
    .events-sektion__titel,
    .events-sektion__inhalt,
    .events-hinweis {
      grid-column: 1 / -1;
    }

    /* Nicht sticky auf Tablet und Mobil: Die Pillen brechen dort auf zwei
       Zeilen um und würden zusammen mit Titel und Trefferzähler rund ein
       Viertel des Viewports dauerhaft belegen — bei Zeilen von etwa 200 Pixel
       Höhe ein schlechter Tausch. Der Block scrollt einfach mit. */
    .events-sektion__aside {
      position: static;
      gap: var(--space-6);
      margin-bottom: var(--space-12);
    }

    .hero__head,
    .hero__media {
      grid-column: 1 / -1;
    }

    .hero__titel {
      max-width: 16ch;
    }

    /* Ab Tablet abwärts bleibt das Bild in der Containerbreite und trägt den
       globalen Medienradius, statt randlos auszulaufen. */
    .hero__media img {
      width: 100%;
      aspect-ratio: 16 / 9;
      max-height: 22rem;
      border-radius: var(--radius-image);
    }

    /* Drei Spalten für den Datumsblock sind hier zu schmal für "30. Sep –
       2. Okt 2026" — die Karte wird einspaltig. */
    .naechster__karte,
    .naechster__karte:not(:has(.naechster__bild)) {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-6);
    }

    .naechster__bild {
      max-width: 22rem;
    }
  }

  @media (max-width: 42rem) {
    .hero__titel {
      max-width: 100%;
    }

    .hero__media img {
      aspect-ratio: 4 / 3;
      max-height: 18rem;
    }
  }
</style>
