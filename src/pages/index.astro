<script>
  const image = document.querySelector<HTMLElement>("[data-parallax-image]");

  if (image) {
    const stillMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    // Delay-Stellschraube: kleiner Wert = starker Nachlauf, größerer Wert = folgt fast direkt
    const DAMPING = 0.08;
    const EPSILON = 0.001;

    let current = 0;
    let target = 0;
    let isVisible = false;
    let animationFrame = 0;

    const measureTarget = () => {
      const rect = image.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      const centerOffset = rect.top + rect.height / 2 - viewportHeight / 2;
      const range = viewportHeight / 2 + rect.height / 2;
      target = Math.min(1, Math.max(-1, -centerOffset / range));
    };

    const tick = () => {
      measureTarget();
      current += (target - current) * DAMPING;
      image.style.setProperty("--procedure-parallax-progress", current.toFixed(4));
      animationFrame = Math.abs(target - current) > EPSILON ? requestAnimationFrame(tick) : 0;
    };

    const wake = () => {
      if (animationFrame || stillMotion.matches || !isVisible) return;
      animationFrame = requestAnimationFrame(tick);
    };

    const visibility = new IntersectionObserver(
      ([entry]) => {
        isVisible = entry.isIntersecting;
        if (isVisible) wake();
      },
      { threshold: 0 }
    );

    const start = () => {
      if (stillMotion.matches) {
        if (animationFrame) {
          cancelAnimationFrame(animationFrame);
          animationFrame = 0;
        }
        current = 0;
        target = 0;
        image.style.setProperty("--procedure-parallax-progress", "0");
        return;
      }

      wake();
    };

    visibility.observe(image);
    window.addEventListener("scroll", wake, { passive: true });
    window.addEventListener("resize", wake);
    stillMotion.addEventListener("change", start);
    start();
  }
</script>

<script>
  const marker = document.querySelector<HTMLElement>("[data-sechsecke]");

  if (marker) {
    const stillMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let inReichweite = false;
    let geladen = false;

    // GSAP kommt erst, wenn die Sektion in Reichweite ist und Bewegung
    // erwünscht ist; alle anderen laden die rund 45 KB nie.
    const laden = async () => {
      if (geladen || !inReichweite || stillMotion.matches) return;
      geladen = true;

      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import("gsap"),
        import("gsap/ScrollTrigger"),
      ]);
      gsap.registerPlugin(ScrollTrigger);
      // Ein- und ausfahrende Adressleisten auf Mobilgeräten ändern die
      // Fensterhöhe; ohne diese Einstellung springt die Animation dabei.
      ScrollTrigger.config({ ignoreMobileResize: true });

      // matchMedia nimmt die Animation zurück, sobald reduzierte Bewegung
      // nachträglich aktiviert wird, und baut sie beim Deaktivieren neu auf.
      gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
        marker.setAttribute("data-sechsecke-aktiv", "");
        // Beide Hälften sind gleich lang, und der Weg vom Start zur Mitte
        // entspricht dem von der Mitte zum Ende. Deckungsgleich sind die
        // Sechsecke damit genau, wenn das Motiv in der Bildschirmmitte steht.
        gsap
          .timeline({
            // Start erst, wenn das Motiv halb im Bild ist; sonst ist die
            // Bewegung größtenteils vorbei, bevor man sie sieht.
            scrollTrigger: {
              trigger: marker,
              start: "center bottom",
              end: "center top",
              scrub: 0.5,
            },
          })
          .fromTo(marker, { "--zusammen": 0 }, { "--zusammen": 1, ease: "sine.inOut" })
          .to(marker, { "--zusammen": 2, ease: "sine.inOut" });

        return () => marker.removeAttribute("data-sechsecke-aktiv");
      });
    };

    new IntersectionObserver(
      ([entry], beobachter) => {
        if (!entry.isIntersecting) return;
        inReichweite = true;
        beobachter.disconnect();
        laden();
      },
      { rootMargin: "100% 0px" },
    ).observe(marker);

    stillMotion.addEventListener("change", laden);
  }
</script>
