---
export interface Props {
  as?: "div" | "section" | "ul" | "ol" | "nav";
  class?: string;
}

const { as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["layout-grid", className]}>
  <slot />
</Tag>

<style>
  .layout-grid {
    display: grid;
    grid-template-columns: repeat(var(--site-column-count), minmax(0, 1fr));
    column-gap: var(--site-gutter);
    row-gap: var(--grid-row-gap, var(--site-gutter));
  }

  :global(.layout-grid > *) {
    min-width: 0;
  }
</style>
