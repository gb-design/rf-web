---
interface Props {
  name: "arrow" | "calendar";
}

const { name } = Astro.props;
---

{name === "arrow" ? (
  <svg class="rf-button__icon rf-button__icon--arrow" aria-hidden="true" viewBox="0 0 16 16">
    <path d="M3 8h10M9 4l4 4-4 4" />
  </svg>
) : (
  <svg class="rf-button__icon" aria-hidden="true" viewBox="0 0 16 16">
    <rect x="2" y="3" width="12" height="11" rx="1" />
    <path d="M5 1v4M11 1v4M2 7h12" />
  </svg>
)}
