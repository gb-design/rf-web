---
// Kleine Marker fuer Metazeilen (Datum, Uhrzeit, Ort). Bewusst getrennt von
// ButtonIcon.astro: dessen Groesse und Hover-Transform haengen an .rf-button,
// hier zaehlt stattdessen die Ausrichtung auf der Grundlinie des Mono-Textes.
// Der doppelte Kalenderpfad ist der Preis dafuer und in Kauf genommen.
interface Props {
  name: "calendar" | "clock" | "pin";
}

const { name } = Astro.props;
---

<svg class="meta-icon" aria-hidden="true" viewBox="0 0 16 16" focusable="false">
  {name === "calendar" && (
    <>
      <rect x="2" y="3" width="12" height="11" rx="1.5" />
      <path d="M5 1.5v3M11 1.5v3M2 7h12" />
    </>
  )}
  {name === "clock" && (
    <>
      <circle cx="8" cy="8" r="6" />
      <path d="M8 4.5V8l2.5 1.75" />
    </>
  )}
  {name === "pin" && (
    <>
      <path d="M8 14.5s5-4.4 5-8a5 5 0 0 0-10 0c0 3.6 5 8 5 8Z" />
      <circle cx="8" cy="6.5" r="1.75" />
    </>
  )}
</svg>

<style>
  .meta-icon {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* Optische Grundlinie: das Quadrat sitzt sonst minimal zu hoch neben
       Ziffern, die keine Unterlaenge haben. */
    transform: translateY(0.05em);
  }
</style>
