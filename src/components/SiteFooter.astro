---
import ButtonLink from "./ButtonLink.astro";
import Container from "./Container.astro";
import Grid from "./Grid.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer" data-section-theme="dark">
  <Container>
    <Grid class="site-footer__primary">
      <div class="site-footer__brand">
        <a href="/" aria-label="Dr. René H. Fortelny – Startseite">
          <img src="/rf_logo.svg" alt="Dr. René H. Fortelny" width="217" height="58" loading="lazy" />
        </a>
        <p>Hernien- und Viszeralchirurgie in Wien. Persönliche Beratung, präzise Diagnostik und individuell abgestimmte Behandlung.</p>
      </div>

      <div class="site-footer__navigation">
        <div>
          <p class="site-footer__label">Navigation</p>
          <nav aria-label="Navigation im Footer">
            <a href="/profil">Profil</a>
            <a href="/leistungen">Leistungen</a>
            <a href="/events">Events</a>
            <a href="/galerie">Galerie</a>
          </nav>
        </div>
        <div>
          <p class="site-footer__label">Kontakt</p>
          <p>Für Terminabsprachen und organisatorische Fragen.</p>
          <ButtonLink href="/kontakt" variant="text" arrow>Kontakt aufnehmen</ButtonLink>
        </div>
      </div>
    </Grid>

    <Grid class="site-footer__legal">
      <p>© {year} Dr. René H. Fortelny</p>
      <nav aria-label="Rechtliche Informationen">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </nav>
    </Grid>
  </Container>
</footer>

<script>
  import "../scripts/footerVorhang.ts";
</script>

<style>
  .site-footer {
    color: var(--color-text);
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  /* Der Vorhang: der Footer steht fest am unteren Viewportrand, .page-wrap
     liegt darüber und schiebt sich beim Scrollen weg. */
  :global(html[data-footer="reveal"]) .site-footer {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 0;
  }

  @media print {
    .site-footer {
      position: static;
    }
  }

  :global(.site-footer__primary) {
    padding-block: clamp(var(--space-16), 9vw, var(--space-24));
  }

  .site-footer__brand {
    grid-column: 1 / span 5;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
  }

  .site-footer__brand img {
    width: min(13.5625rem, 100%);
    height: auto;
  }

  .site-footer__brand p,
  .site-footer__navigation div > p:not(.site-footer__label) {
    max-width: 48ch;
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }

  .site-footer__navigation {
    grid-column: 7 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12);
  }

  .site-footer__navigation > div {
    align-content: start;
    display: grid;
    gap: var(--space-4);
  }

  .site-footer__label {
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .site-footer__navigation nav {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .site-footer__navigation nav a,
  .site-footer__legal a {
    width: fit-content;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    color: var(--color-text);
    font-family: var(--font-display);
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }

  .site-footer__navigation nav a:hover,
  .site-footer__legal a:hover {
    color: var(--color-primary);
    text-decoration-color: currentColor;
  }

  :global(.site-footer__legal) {
    min-height: 5rem;
    padding-block: var(--space-4);
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--text-label);
    border-top: 1px solid var(--color-border);
  }

  :global(.site-footer__legal) > p {
    grid-column: 1 / span 6;
  }

  :global(.site-footer__legal) nav {
    grid-column: 7 / -1;
    justify-self: end;
    display: flex;
    gap: var(--space-6);
  }

  .site-footer__legal a {
    color: var(--color-text-muted);
  }

  @media (max-width: 48rem) {
    .site-footer__brand,
    .site-footer__navigation {
      grid-column: 1 / -1;
    }

    :global(.site-footer__primary) {
      row-gap: var(--space-16);
    }
  }

  @media (max-width: 34rem) {
    .site-footer__navigation {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    :global(.site-footer__legal) {
      padding-block: var(--space-6);
      align-items: flex-start;
      row-gap: var(--space-2);
    }

    :global(.site-footer__legal) > p,
    :global(.site-footer__legal) nav {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
</style>
