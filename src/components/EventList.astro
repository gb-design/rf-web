---
import EventCard from "./EventCard.astro";
import type { EventItem } from "../lib/events";

interface Props {
  events: EventItem[];
}

const { events } = Astro.props;
---

<ol class="events__liste">
  {events.map((event) => <EventCard event={event} />)}
</ol>

<style>
  .events__liste {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>

<style is:global>
  /* Diese Regeln verbinden die Checkboxen aus EventFilter mit den Zeilen aus
     EventCard — über zwei Komponentengrenzen und seit der Sticky-Spalte auch
     über zwei Rasterspalten hinweg. Astro hängt an jeden gescopten Selektor
     ein [data-astro-cid-…] der jeweiligen Komponente; eine solche Regel würde
     damit still nie greifen. Deshalb global und vollständig unterhalb von
     .events verschachtelt, damit nichts leckt. */
  .events:has(.filter__input:checked) .event {
    display: none;
  }

  .events:has(#f-congress:checked) .event[data-type="congress"],
  .events:has(#f-course:checked) .event[data-type="course"],
  .events:has(#f-workshop:checked) .event[data-type="workshop"],
  .events:has(#f-webinar:checked) .event[data-type="webinar"] {
    display: var(--event-display, grid);
  }

  /* Eine gefilterte Ansicht darf sich nicht in den Ausdruck fortsetzen. */
  @media print {
    .events .event {
      display: var(--event-display, grid) !important;
    }

    .events .filter {
      display: none;
    }
  }
</style>
