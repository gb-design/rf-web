---
import type { TypAuswahl } from "../lib/events";

interface Props {
  typen: TypAuswahl[];
  gesamt: number;
}

const { typen, gesamt } = Astro.props;
---

<form class="filter" id="event-filter">
  <p class="filter__status" role="status" aria-live="polite" data-gesamt={gesamt}>
    <b class="filter__zahl">{gesamt}</b> Termine
  </p>

  <fieldset class="filter__set">
    {/* Bleibt als Zugänglichkeitsname des Fieldsets bestehen, auch wenn er
        visuell entfällt — ohne ihn kündigt die Sprachausgabe eine namenlose
        Gruppe an. */}
    <legend class="visually-hidden">Nach Veranstaltungstyp filtern</legend>

    {typen.map(({ typ, label, anzahl }) => (
      <Fragment>
        <input
          class="filter__input"
          type="checkbox"
          id={`f-${typ}`}
          name="typ"
          value={typ}
          autocomplete="off"
        />
        <label class="filter__label" for={`f-${typ}`}>
          {label}
          <span class="filter__anzahl">{anzahl}</span>
        </label>
      </Fragment>
    ))}

    <button class="filter__reset" type="reset">Alle anzeigen</button>
  </fieldset>
</form>

<script>
  import "../scripts/eventFilter.ts";
</script>

<style>
  .filter__set {
    margin: 0;
    padding: 0;
    border: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  /* Sichtbar versteckt, aber fokussierbar. Der Fokusring liegt auf dem Label. */
  .filter__input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .filter__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    font-size: var(--text-meta);
    line-height: 1.4;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .filter__label:hover {
    border-color: var(--color-primary-strong);
  }

  .filter__anzahl {
    display: inline-grid;
    flex: 0 0 auto;
    place-items: center;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border-radius: 50%;
    background: var(--color-primary-bg);
    color: var(--color-primary-strong);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .filter__input:checked + .filter__label {
    background: var(--color-primary-strong);
    border-color: var(--color-primary-strong);
    color: var(--color-button-text);
  }

  .filter__input:checked + .filter__label .filter__anzahl {
    background: var(--color-button-text);
    color: var(--color-primary-strong);
  }

  .filter__input:checked + .filter__label:hover {
    background: var(--color-primary-strong-hover);
    border-color: var(--color-primary-strong-hover);
  }

  .filter__input:checked + .filter__label:hover .filter__anzahl {
    color: var(--color-primary-strong-hover);
  }

  .filter__input:focus-visible + .filter__label {
    outline: 2px solid var(--color-primary-strong);
    outline-offset: 3px;
  }

  /* `display` statt `visibility`: In der schmalen Sticky-Spalte behielte eine
     nur unsichtbare Schaltfläche ihre Box und belegte eine ganze Flex-Zeile.
     Solange nichts gefiltert ist, gibt es auch nichts zurückzusetzen — der
     Button darf dann ganz entfallen, auch aus der Tabreihenfolge. */
  .filter__reset {
    display: none;
    margin-inline-start: var(--space-2);
    padding: var(--space-2) var(--space-2);
    border: 0;
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--text-meta);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .filter__reset:hover {
    color: var(--color-text);
  }

  .filter__set:has(.filter__input:checked) .filter__reset {
    display: inline;
  }

  /* Steht über den Pillen und deutlich näher an ihnen als am Sektionstitel —
     der Zähler gehört zu den Filtern, nicht zur Überschrift. */
  .filter__status {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-meta);
  }

  /* Mono wie die Zählwerte in den Pillen: technische Werte tragen im Projekt
     ausschließlich diese Schrift. */
  .filter__zahl {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .filter__label,
    .filter__anzahl {
      transition: none;
    }
  }
</style>
