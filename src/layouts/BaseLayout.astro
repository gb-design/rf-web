---
interface Props {
  title: string;
  description?: string;
  robots?: string;
}
const {
  title,
  description = "Dr. René H. Fortelny — Hernien- und Viszeral-Chirurg, Wien",
  robots = "index, follow",
} = Astro.props;

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

// data-footer="static" ist der sichere Ausgangszustand des Footer-Vorhangs:
// erst wenn footerVorhang.ts die Höhe gemessen hat, schaltet es auf "reveal".
// Ohne JavaScript bleibt der Footer ein gewöhnlicher Block am Seitenende.
// Der Hinweis steht hier und nicht als Kommentar vor <html> — ein Ausdruck
// oberhalb des Wurzelelements lässt Astro das Dokument als Fragment behandeln
// und <html> samt <body> aus dem Ergebnis fallen.
---
<!doctype html>
<html lang="de" data-footer="static">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#212137" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/rf_logo.svg" />
  </head>
  <body>
    {/* Außerhalb von .page-wrap, damit der Fokusrahmen nicht vom Stapelkontext
        der Seitenfläche eingeschlossen wird. */}
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    <div class="page-wrap">
      <SiteHeader />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
    </div>
    {/* Ebenfalls Geschwister von .page-wrap: dort greift `overflow: clip` und
        würde den fixierten Footer wegschneiden. */}
    <SiteFooter />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
